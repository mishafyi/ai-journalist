{
  "name": "ai-journalist",
  "version": "0.8.2",
  "bin": {
    "ai-journalist": "./cli/bin.mjs"
  },
  "description": "Turn your data into a researched, fact-checked article. Point it at a JSON file, a feed, or an API and it writes the story.",
  "type": "module",
  "license": "MIT",
  "author": "Zero G Talent",
  "main": "./index.ts",
  "keywords": [
    "ai",
    "llm",
    "blog",
    "content-generation",
    "journalism",
    "article-writing",
    "hexagonal-architecture",
    "ports-and-adapters",
    "openrouter",
    "firecrawl",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishafyi/ai-journalist.git"
  },
  "bugs": {
    "url": "https://github.com/mishafyi/ai-journalist/issues"
  },
  "homepage": "https://github.com/mishafyi/ai-journalist#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.ts",
    "./assembly": "./assembly.ts",
    "./cli": "./cli/main.ts",
    "./clients/auto": "./clients/auto.ts",
    "./clients/datagod": "./clients/datagod.ts",
    "./clients/firecrawl-search": "./clients/firecrawl-search.ts",
    "./clients/ollama-embedder": "./clients/ollama-embedder.ts",
    "./clients/ollama-llm": "./clients/ollama-llm.ts",
    "./clients/openrouter-llm": "./clients/openrouter-llm.ts",
    "./clients/searxng-search": "./clients/searxng-search.ts",
    "./digest": "./digest.ts",
    "./discovery": "./discovery.ts",
    "./gate": "./gate.ts",
    "./gates": "./gates.ts",
    "./headlines.json": "./headlines.json",
    "./matching": "./matching.ts",
    "./news": "./news.ts",
    "./parallels": "./parallels.ts",
    "./pipeline": "./pipeline.ts",
    "./ports": "./ports.ts",
    "./presets": "./presets/default.ts",
    "./presets/default": "./presets/default.ts",
    "./presets/news-desk": "./presets/news-desk.ts",
    "./primitives": "./primitives.ts",
    "./research": "./research.ts",
    "./run-context": "./run-context.ts",
    "./section-writer": "./section-writer.ts",
    "./sources": "./sources/index.ts",
    "./sources/google-news": "./sources/google-news.ts",
    "./sources/newswire": "./sources/newswire.ts",
    "./sources/rss": "./sources/rss.ts",
    "./testing/replay": "./testing/replay.ts",
    "./text": "./text.ts",
    "./write-article": "./write-article.ts"
  },
  "files": [
    
    "cli","*.ts",
    "*.json",
    "presets",
    "sources",
    "clients",
    "testing",
    "examples",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CUSTOMIZING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:checks": "for f in $(find . -name '*.checks.ts' -not -path './node_modules/*'); do npx tsx \"$f\" || exit 1; done",
    "test:example": "vitest run",
    "test": "npm run test:checks && npm run test:example"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@openrouter/sdk": "^0.13.21",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "firecrawl": "^4.25.2",
    "ollama": "^0.6.3",
    "p-limit": "^7.3.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
